# FinGuard AI .gitignore
# Environment & Secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.cert

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# SQLite Databases & Local Test Storage
*.db
*.sqlite
*.sqlite3
test_finguard.db
finguard.db

# Storage & Uploads
storage/invoices/*
!storage/invoices/.gitkeep
storage/documents/*
!storage/documents/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.vite-temp/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
