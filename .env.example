# FinGuard AI Enterprise Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH SECURE, ROTATED VALUES BEFORE DEPLOYMENT.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.

# Application Environment (development, staging, production)
ENVIRONMENT=production
PROJECT_NAME="FinGuard AI"
VERSION=1.0.0
DEBUG=false

# Security & Cryptography (Generate a cryptographically secure 256-bit key: `openssl rand -hex 32`)
SECRET_KEY=YOUR_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection String
# PostgreSQL Production Example: postgresql+asyncpg://db_user:db_password@db_host:5432/finguard_prod?ssl=require
# SQLite Development Example: sqlite+aiosqlite:///./finguard.db
DATABASE_URL=sqlite+aiosqlite:///./finguard.db

# CORS Allowed Origins (Comma-separated exact domains, never wildcards in production)
BACKEND_CORS_ORIGINS=http://localhost:5173,https://yourcompany.finguard.ai

# Rate Limiting & Abuse Prevention
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600

# File Upload Policies
MAX_UPLOAD_SIZE_BYTES=15728640

# LLM / AI Configuration (Provider-agnostic)
LLM_PROVIDER=openai
LLM_API_KEY=YOUR_OPTIONAL_AI_API_KEY_HERE
LLM_MODEL=gpt-4o-mini
